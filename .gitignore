node_modules/

# Raw source material (large binary / OCR dumps / plate renders — keep local, regenerable).
# ⚠ WHOLESALE from 2026-08-28. The per-pattern list below it used to be missed `raw/loci/`
# entirely, and four OCR dumps (~2.9 MB) reached the remote before anyone noticed. Everything
# under raw/ is fetched by a script in tools/ and is regenerable, so the safe rule is "none of
# it", not "these shapes of it".
#   ⚠ THIS DOES NOT UNTRACK WHAT IS ALREADY COMMITTED. raw/loci/'s four files are still in the
#   history and still on the remote; removing them is a history rewrite and Wilson's call. They
#   are public-domain texts and harmless in themselves — but the repo flips PUBLIC at M5, so
#   settle it before then.
raw/

# Python caches
**/__pycache__/

# Bulk export (regenerated by site/scripts/build-export.mjs; hosted on the
# shared Cloudflare R2 bucket, not committed — see ~/open-corpus/PLAN.md item 8)
# Leading slash anchors this to the repo root — otherwise it also matches
# site/src/app/export/ (the Next.js route), which must stay tracked.
/export/

status.html
